# Copy to .env. With DRY_RUN=true nothing external is called and the dev secrets below work.
DRY_RUN=true
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# CHANGE BOTH before exposing the API. Generate: python -c "import secrets;print(secrets.token_hex(32))"
WEBHOOK_SECRET=dev-webhook-secret
SLACK_SIGNING_SECRET=dev-slack-signing-secret
# Client Secret of your Sentry internal integration; enables POST /webhook/sentry. Empty = disabled.
SENTRY_CLIENT_SECRET=

# Needed only when DRY_RUN=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#oncall
# Slack user IDs allowed to click "Create Hotfix PR". Empty = nobody in live mode.
SLACK_APPROVER_IDS=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CHROMA_PATH=.chroma
PR_CONFIDENCE_THRESHOLD=0.6
DEDUP_TTL_SECONDS=300
INCIDENT_TTL_SECONDS=604800
MAX_DIFF_CHARS=4000
MAX_FILE_CHARS=60000
